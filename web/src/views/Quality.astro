---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import { cleanReport, coverage, first, fuelLabels, int, last, manifest } from '../lib/data';
import { countBars } from '../lib/charts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = (pt: string, en: string) => (lang === 'pt' ? pt : en);
const from = first(coverage);
const to = last(coverage);
const labelsIn = (year: number) => fuelLabels.filter((r) => r.ref_year === year);
const fuels = [...new Set(fuelLabels.filter((r) => r.ref_year >= 2023 && r.ref_year <= 2024).map((r) => r.fuel))].sort();
const count = (year: number, fuel: string) => labelsIn(year).find((r) => r.fuel === fuel)?.prices ?? 0;
const r = cleanReport;

const chart = countBars(
  coverage.map((c) => ({ year: c.ref_year, value: c.prices })),
  {
    labelled: [from.ref_year, to.ref_year],
    format: (v) => int(v, lang),
    aria: L(
      `Barras com o número de preços por janeiro, crescendo de ${int(from.prices, lang)} em ${from.ref_year} para ${int(to.prices, lang)} em ${to.ref_year}.`,
      `Bars with the number of prices per January, growing from ${int(from.prices, lang)} in ${from.ref_year} to ${int(to.prices, lang)} in ${to.ref_year}.`,
    ),
  },
);
---

<Base lang={lang} page="quality" title={L('Os dados', 'The data')}>
  <article class="wrap page">
    <p class="eyebrow">{t(lang, 'nav.quality')}</p>
    <h1>{L('O que entrou, o que saiu e o que a FIPE mudou', 'What went in, what came out and what FIPE changed')}</h1>
    <p class="lede">
      {L(
        `${int(r.rows_out, lang)} preços de janeiro, de ${from.ref_year} a ${to.ref_year}, depois da limpeza de ${int(r.rows_in, lang)} linhas brutas.`,
        `${int(r.rows_out, lang)} January prices, ${from.ref_year} to ${to.ref_year}, after cleaning ${int(r.rows_in, lang)} raw rows.`,
      )}
    </p>

    <figure class="figure">
      <Fragment set:html={chart} />
      <figcaption>{L('Preços por janeiro. A tabela cresce porque a FIPE acrescenta modelos e anos-modelo.', 'Prices per January. The table grows because FIPE adds models and model years.')}</figcaption>
    </figure>

    <div class="prose">
      <h2>{L('Limpeza', 'Cleaning')}</h2>
      <ul>
        <li>{L(`Códigos, preços ou anos inválidos: ${int(r.invalid_codigo + r.invalid_price + r.invalid_year, lang)}.`, `Invalid codes, prices or years: ${int(r.invalid_codigo + r.invalid_price + r.invalid_year, lang)}.`)}</li>
        <li>{L(
          `Duplicatas removidas: ${int(r.duplicates_dropped, lang)}, quase todas preços que aparecem tanto na coleta nova quanto nos arquivos antigos; com preço diferente entre as cópias: ${int(r.duplicate_conflicts, lang)}.`,
          `Duplicates removed: ${int(r.duplicates_dropped, lang)}, almost all prices present both in the new collection and in the old files; with different prices between copies: ${int(r.duplicate_conflicts, lang)}.`,
        )}</li>
        <li>{L(
          `Origem: ${int(r.rows_from_csv_v1, lang)} dos arquivos coletados em 2023-2025 e ${int(r.rows_from_api, lang)} da coleta atual, conferidos entre si.`,
          `Source: ${int(r.rows_from_csv_v1, lang)} from files collected in 2023-2025 and ${int(r.rows_from_api, lang)} from the current collection, checked against each other.`,
        )}</li>
      </ul>

      <h2>{L('A troca de rótulo de combustível em 2024', 'The 2024 fuel relabel')}</h2>
      <p>
        {L(
          'Em janeiro de 2024 a FIPE passou a separar Flex, Híbrido, Elétrico e Gás Natural, que antes apareciam como Gasolina nos mesmos carros. Para seguir um carro entre anos, o site junta esses rótulos num grupo "gasolina" (álcool e diesel ficam separados). Com isso, nenhum carro tem dois preços no mesmo grupo e mês: ',
          'In January 2024 FIPE started to tell apart Flex, Hybrid, Electric and Natural Gas, which used to appear as Gasolina for the same cars. To follow a car across years, the site merges these labels into a "gasoline" group (alcohol and diesel stay apart). With that, no car has two prices in the same group and month: ',
        )}
        {int(r.fuel_group_collisions, lang)} {L('colisões', 'collisions')}.
      </p>
      <div class="table-wrap">
        <table class="num">
          <thead><tr><th>{L('Rótulo', 'Label')}</th><th>2023</th><th>2024</th></tr></thead>
          <tbody>
            {fuels.map((f) => (
              <tr><td>{f}</td><td>{int(count(2023, f), lang)}</td><td>{int(count(2024, f), lang)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>{L('Arquivos', 'Files')}</h2>
      <p>
        {L(
          'Todas as tabelas do site estão em /data/ (JSON e CSV), com a descrição de cada uma em manifest.json. São só agregados: nenhum arquivo traz o preço de um carro. ',
          'Every table on the site is in /data/ (JSON and CSV), each described in manifest.json. Aggregates only: no file carries the price of a single car. ',
        )}
        <a href="/data/manifest.json">manifest.json</a>
      </p>
      <p class="note">{manifest.attribution}</p>
    </div>

    <details class="data">
      <summary>{t(lang, 'table.show')}</summary>
      <div class="table-wrap">
        <table class="num">
          <thead>
            <tr>
              <th>{L('Janeiro', 'January')}</th>
              <th>{L('Preços', 'Prices')}</th>
              <th>{L('Zero km', 'Brand new')}</th>
              <th>{L('Códigos FIPE', 'FIPE codes')}</th>
              <th>{L('Marcas', 'Brands')}</th>
            </tr>
          </thead>
          <tbody>
            {coverage.map((c) => (
              <tr>
                <td>{c.ref_year}</td>
                <td>{int(c.prices, lang)}</td>
                <td>{int(c.new_car_prices, lang)}</td>
                <td>{int(c.codigos_fipe, lang)}</td>
                <td>{int(c.brands, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </article>
</Base>

<style>
  ul { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
</style>
