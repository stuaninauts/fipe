---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hreflang, otherLang, path, t, type Lang, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** The page id; every page exists in both languages (none for the 404). */
  page?: Page;
  title?: string;
  description?: string;
}

const { lang, page, title, description = t(lang, 'site.description') } = Astro.props;
const fullTitle = title ? `${title} · Fipe` : `${t(lang, 'site.title')} · Fipe`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = otherLang(lang);
const alternate = page ? path(other, page) : undefined;
---

<!doctype html>
<html lang={hreflang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && (
      <>
        <link rel="alternate" hreflang={hreflang(lang)} href={canonical} />
        <link rel="alternate" hreflang={hreflang(other)} href={new URL(alternate, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? canonical : new URL(alternate, Astro.site)} />
      </>
    )}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f1ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1a18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fipe" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} page={page} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
