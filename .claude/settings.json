{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bash .claude/hooks/test-guard-bash.sh)",
      "Bash(bash scripts/gh.sh auth status *)",
      "Bash(bash scripts/gh.sh pr list *)",
      "Bash(bash scripts/gh.sh pr view *)",
      "Bash(bash scripts/gh.sh pr checks *)",
      "Bash(bash scripts/gh.sh run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(npm install *)",
      "Bash(npx wrangler *)",
      "Bash(bash scripts/gh.sh pr merge *)",
      "Bash(bash scripts/gh.sh api *)",
      "Bash(bash scripts/gh.sh repo *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(~/.ssh/**)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
